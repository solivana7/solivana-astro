DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
BLOB_READ_WRITE_TOKEN=""
ANTHROPIC_API_KEY="sk-ant-..."
# Optional: override the default Claude model (claude-sonnet-4-6)
# AI_MODEL="claude-sonnet-4-6"
RESEND_API_KEY="re_..."
FROM_EMAIL="info@solivana.com"
APP_URL="https://astro.solivana.io"
INTERNAL_API_SECRET=""
CRON_SECRET=""

# Payments (optional — unset means free mode, used by dev and tests)
# Stripe secret key, server-only. From dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..."
# Stripe Payment Link URL for one reading (dashboard.stripe.com/payment-links).
# Set its success URL to https://astro.solivana.io/reading?session_id={CHECKOUT_SESSION_ID}
NEXT_PUBLIC_STRIPE_PAYMENT_LINK="https://buy.stripe.com/..."
# Price shown in the form (display only — the link controls the real amount)
NEXT_PUBLIC_KARMIC_PRICE="$19"
